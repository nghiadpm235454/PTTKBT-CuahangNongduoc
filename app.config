<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <!-- ReportViewer 2010 goi ExecuteReportInCurrentAppDomain(Evidence) trong frmSoLuongBan, frmInPhieuBan, frmInPhieuNhap.
         .NET 4.0+ tat CAS policy mac dinh -> phai bat lai thi moi chay duoc (code goc co san, khong phai do refactor). -->
    <NetFx40_LegacySecurityPolicy enabled="true"/>
  </runtime>
</configuration>
